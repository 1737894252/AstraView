<Window x:Class="StarImageViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AstraView" Width="1120" Height="780" MinWidth="640" MinHeight="440"
        WindowStyle="None" ResizeMode="CanResize" Background="#111419" Foreground="{StaticResource TextBrush}"
        AllowDrop="True" Drop="Window_Drop" KeyDown="Window_KeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="10" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#343947" BorderThickness="1" CornerRadius="10" Background="#111419">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition x:Name="FilmstripRow" Height="0" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>

            <!-- Photos-style top command bar -->
            <Border Grid.Row="0" Background="#1A1E25" CornerRadius="9,9,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid x:Name="TitleBarGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="LeftCommands" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"
                                Panel.ZIndex="1"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Image Source="astraview-header.png" Width="32" Height="32" Margin="4,0,8,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <Button Style="{StaticResource ToolbarButton}" Click="Open_Click" ToolTip="打开图片 (Ctrl+O)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                                <TextBlock Text="打开" Margin="7,0,0,0" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" Click="OpenFolder_Click" ToolTip="打开文件夹 (Ctrl+Shift+O)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                                <TextBlock Text="文件夹" Margin="7,0,0,0" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" Click="RecentFolders_Click" ToolTip="最近打开的文件夹">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="RecentFoldersMenu" Opened="RecentFoldersMenu_Opened"
                                             Background="#242932" BorderBrush="#3B424E" BorderThickness="1"
                                             Padding="5" HasDropShadow="True">
                                    <ContextMenu.Template>
                                        <ControlTemplate TargetType="ContextMenu">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                            </Border>
                                        </ControlTemplate>
                                    </ContextMenu.Template>
                                    <ContextMenu.Resources>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Foreground" Value="#F1F3F7" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Padding" Value="11,8" />
                                            <Setter Property="MinWidth" Value="260" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="MenuItem">
                                                        <Border x:Name="MenuItemBorder" Background="{TemplateBinding Background}"
                                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter ContentSource="Header" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsHighlighted" Value="True">
                                                                <Setter TargetName="MenuItemBorder" Property="Background" Value="#3A414D" />
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.48" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                        <Style TargetType="Separator">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Separator">
                                                        <Border Height="1" Background="#454C58" Margin="7,4" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ContextMenu.Resources>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                <TextBlock Text="最近" Margin="7,0,0,0" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" Content="&#xE76B;" FontFamily="Segoe MDL2 Assets"
                                FontSize="16" Click="Previous_Click" ToolTip="上一张 (←)" />
                        <Button Style="{StaticResource ToolbarButton}" Content="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                FontSize="16" Click="Next_Click" ToolTip="下一张 (→)" />
                        <Button Style="{StaticResource ToolbarButton}" Content="&#xE7AD;" FontFamily="Segoe MDL2 Assets"
                                FontSize="16" Click="Rotate_Click" ToolTip="顺时针旋转" />
                        <Button Style="{StaticResource ToolbarButton}" Content="适应" FontSize="11" FontWeight="SemiBold"
                                Click="Fit_Click" ToolTip="适应窗口" />
                        <Button Style="{StaticResource ToolbarButton}" Content="1:1" FontSize="11" FontWeight="SemiBold"
                                Click="Actual_Click" ToolTip="实际大小" />
                    </StackPanel>

                    <TextBlock x:Name="TitleText" Grid.Column="0" Grid.ColumnSpan="3" Text="AstraView"
                               FontSize="13" FontWeight="SemiBold" Panel.ZIndex="0"
                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               Foreground="#E8EAF0" IsHitTestVisible="False" />

                    <StackPanel x:Name="WindowCommands" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                Panel.ZIndex="1"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="最小化" />
                        <Button Style="{StaticResource WindowButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="最大化" />
                        <Button x:Name="CloseButton" Style="{StaticResource WindowButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="关闭" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Unobstructed image canvas -->
            <Border Grid.Row="1" x:Name="Viewport" ClipToBounds="True"
                    MouseWheel="Viewport_MouseWheel" MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
                    MouseLeftButtonUp="Viewport_MouseLeftButtonUp" MouseMove="Viewport_MouseMove">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#171B21" Offset="0" />
                        <GradientStop Color="#101318" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Canvas x:Name="ImageStage">
                        <Image x:Name="Picture" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
                                    <RotateTransform x:Name="RotateTransform" Angle="0" />
                                    <TranslateTransform x:Name="PanTransform" />
                                </TransformGroup>
                            </Image.RenderTransform>
                            <Image.RenderTransformOrigin>0.5,0.5</Image.RenderTransformOrigin>
                        </Image>
                    </Canvas>
                    <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="astraview-header.png" Width="72" Height="72" Opacity="0.7"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="打开一张图片" FontSize="19" FontWeight="SemiBold" TextAlignment="Center" Margin="0,15,0,0" />
                        <TextBlock Text="拖放图片到此处，或使用顶部的打开按钮" FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center" Margin="0,7,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Horizontal folder filmstrip -->
            <Border x:Name="FolderPanel" Grid.Row="2" Visibility="Collapsed" Background="#181C22"
                    BorderBrush="#2B3039" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="16,0,10,0">
                        <TextBlock Text="当前文件夹" Foreground="#777F90" FontSize="10" />
                        <TextBlock x:Name="FolderNameText" Text="图片" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                    </StackPanel>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="18" />
                        </Grid.RowDefinitions>
                        <ScrollViewer x:Name="FolderScrollViewer" Grid.Row="0"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                      Padding="4,7,14,3" PreviewMouseWheel="FolderScrollViewer_PreviewMouseWheel"
                                      ScrollChanged="FolderScrollViewer_ScrollChanged">
                            <WrapPanel x:Name="ThumbnailPanel" Orientation="Horizontal" />
                        </ScrollViewer>
                        <ScrollBar x:Name="FolderHorizontalScrollBar" Grid.Row="1" Orientation="Horizontal"
                                   Height="9" Margin="8,3,14,6" SmallChange="40" LargeChange="180"
                                   Scroll="FolderHorizontalScrollBar_Scroll">
                            <ScrollBar.Template>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Height="9" Background="Transparent">
                                        <Border Height="3" VerticalAlignment="Center" Background="#282D35" CornerRadius="2" />
                                        <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="False">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" />
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb MinWidth="34" Cursor="Hand">
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border x:Name="ThumbBody" Height="4" VerticalAlignment="Center"
                                                                    Background="#687180" CornerRadius="2" />
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ThumbBody" Property="Background" Value="#A4ACB9" />
                                                                    <Setter TargetName="ThumbBody" Property="Height" Value="6" />
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter TargetName="ThumbBody" Property="Background" Value="#8B7CF6" />
                                                                    <Setter TargetName="ThumbBody" Property="Height" Value="6" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" />
                                            </Track.IncreaseRepeatButton>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </ScrollBar.Template>
                        </ScrollBar>
                    </Grid>
                </Grid>
            </Border>

            <!-- Bottom information bar -->
            <Border Grid.Row="3" Background="#20242B" CornerRadius="0,0,9,9" BorderBrush="#30353E" BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#AAB0BD" FontSize="11" Text="准备就绪" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ToolbarButton}" Content="适应" FontSize="10" Padding="8,4" Click="Fit_Click" />
                        <Border Background="#303640" CornerRadius="7" Padding="11,5" Margin="5,0,0,0">
                            <TextBlock x:Name="ZoomText" Text="—" Foreground="#D5D1FF" FontSize="11"
                                       FontWeight="SemiBold" MinWidth="42" TextAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
